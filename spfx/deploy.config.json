{
  "$schema": "https://raw.githubusercontent.com/ferrarirosso/spfx-foundry-deploy/main/deploy.config.schema.json",
  "slug": "imageo",
  "profile": "multi-model",
  "namePrefix": "imageo-dev",
  "location": "swedencentral",
  "backendPath": "../backend",
  "models": [
    {
      "name": "gpt-5-mini",
      "deploymentName": "imageo-dev-gpt5mini",
      "version": "2025-08-07",
      "format": "OpenAI",
      "skuName": "GlobalStandard",
      "skuCapacity": 50,
      "apiVersion": "2024-10-21",
      "$role": "analyze"
    },
    {
      "name": "MAI-Image-2.5-Flash",
      "deploymentName": "imageo-dev-mai25flash",
      "version": "2026-06-02",
      "format": "Microsoft",
      "skuName": "GlobalStandard",
      "skuCapacity": 2,
      "apiVersion": "preview",
      "$role": "image"
    }
  ],
  "requestLimits": {
    "perMinute": 30,
    "perDay": 1000
  }
}
