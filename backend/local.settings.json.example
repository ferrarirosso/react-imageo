{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "AZURE_OPENAI_ENDPOINT": "https://<foundry>.cognitiveservices.azure.com/",
    "AZURE_OPENAI_API_KEY": "<foundry-key-1>",
    "AZURE_OPENAI_DEPLOYMENT_IMAGE": "<your-image-deployment-name>",
    "AZURE_OPENAI_DEPLOYMENT_ANALYZE": "<your-analysis-deployment-name>",
    "AZURE_OPENAI_API_VERSION_IMAGE": "preview",
    "AZURE_OPENAI_API_VERSION_ANALYZE": "v1",
    "IMAGE_MODEL_LABEL": "MAI-Image-2.7-Flash",
    "TENANT_ID": "<tenant-id>",
    "CLIENT_ID": "<aad-app-id>",
    "CLIENT_SECRET": "<aad-app-secret>",
    "IMAGE_MAX_N": "2",
    "REQUIRE_AUTH": "false",
    "ALLOW_DEV_BEARER_TOKENS": "true"
  },
  "Host": {
    "CORS": "*",
    "CORSCredentials": false,
    "LocalHttpPort": 7071
  }
}
